[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/pause.gd" id="script"]
[ext_resource type="Theme" path="res://src/ui/theme.tres" id="theme"]

[node name="Pause" type="CanvasLayer"]
process_mode = 3
layer = 10
script = ExtResource("script")

[node name="Panel" type="PanelContainer" parent="."]
theme = ExtResource("theme")
offset_left = 220.0
offset_top = 100.0
offset_right = 1060.0
offset_bottom = 620.0

[node name="Buttons" type="VBoxContainer" parent="Panel"]
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="Panel/Buttons"]
size_flags_vertical = 3
horizontal_alignment = 1
vertical_alignment = 1
theme_override_font_sizes/font_size = 22
text = "已暂停"

[node name="Resume" type="Button" parent="Panel/Buttons"]
text = "继续"
custom_minimum_size = Vector2(0, 48)

[node name="Map" type="Button" parent="Panel/Buttons"]
text = "地图"
custom_minimum_size = Vector2(0, 48)

[node name="Restart" type="Button" parent="Panel/Buttons"]
text = "重新开始（仅清除 Godot 新工程进度）"
custom_minimum_size = Vector2(0, 48)
