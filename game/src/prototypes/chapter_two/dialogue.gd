class_name ChapterTwoDialogue
extends RefCounted
## 白盒对白提案。人物只回应自己知道的事，鲸歌不构成通行许可。
const LINES: Dictionary = {
	"arrival":[
		["旁白","下面响起一阵拖拽声。旧壳擦过台面，停在两根支柱之间。"],
		["拾潮者","刚才还听得见……怎么到这里又断了？"]],
	"refusal":[
		["负壳守卫","停。下面不走人。"],
		["拾潮者","出什么事了？"],
		["负壳守卫","有根梁歪了，巢里的人还没撤完。往后站。"],
		["拾潮者","我从须庭一路找过来。有个声音，到了这儿就听不见了。"],
		["负壳守卫","下面拖壳、敲梁，什么声音都有。你去上头等。"],
		["拾潮者","要等多久？"],
		["负壳守卫","人上来了，我会叫你。"],
		["拾潮者","它响不了多久。我从边上过去，不碰那根梁。"],
		["负壳守卫","边上也不行。退回去。"]],
	"aftermath":[
		["旁白","守卫伏在旧壳旁，钳尖还指着下层。"],
		["负壳守卫","别往下走！他们还在底下！"]],
	"permit":[
		["老守护者","还有人没上来吗？"],
		["住户","都在这儿了。最里面那一家也出来了。"],
		["老守护者","去胃室那边等着，别挤在断口上。"],
		["老守护者","你的壳怎么拖在地上？"],
		["负壳守卫（上层）","扣带断了。他非要往下走，我没让，打起来了。"],
		["拾潮者","是我动的手。我想从旁边过去，没想伤他。"],
		["老守护者","他跟你说过下面有人吗？"],
		["拾潮者","说过。"],
		["旁白","老守护者没有接话。几户住户挤在断口旁。"],
		["拾潮者","我确实听见了一个声音。从外面就开始了，到须庭又响过一次。"],
		["老守护者","我没听见。你先让让，后面还有人要过去。"],
		["负壳守卫","这段路还封着吗？"],
		["老守护者","人都上来了，不用拦了。你先歇着，等换梁的人下来。"],
		["拾潮者","右边能到胃室？"],
		["老守护者","能。他们也去那边，你跟着走吧。"]],
	"complete":[
		["住户","往这边。前面有落差，你看着脚下。"],
		["旁白","住户沿台面往前走，折井的断口留在身后。"],
		["白盒验证结束","已到胃室入口。F继续第三章白盒；R回检查点，F6从头重玩。"]],
	"guard_repeat":[
		["负壳守卫","人还没上来。你去上头等，别在这儿挤。"]],
	"elder_repeat":[
		["拾潮者","刚才……我能帮点什么？"],
		["老守护者","先让这几户过去。别挡着他们。"]]
}

static func lines(id: String) -> Array[Array]:
	var result: Array[Array] = []
	for line: Array in LINES.get(id,[]): result.append(line.duplicate())
	return result
