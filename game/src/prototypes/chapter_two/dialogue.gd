	"guard_repeat": [
		["负壳守卫", "折井下面的住户还没撤完。你回上面的平台等，不要挡住撤离的路。"]
	],
	"elder_repeat": [
		["拾潮者", "守卫的扣带是我打断的。我现在能帮你们做什么？"],
		["老守护者", "你先把通道让出来，让这几户住户去胃室。"]
	]
