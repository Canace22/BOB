	"arrival": [
		["旁白", "折井下方传来拖拽声。负壳守卫把一具旧壳拖到路中央，挡住了下行的通道。"],
		["拾潮者", "我在须庭听到的低鸣，刚才还从井底传上来，怎么现在又听不见了？"]
	],
	"refusal": [
		["负壳守卫", "下面正在撤人，你先退回上面的平台，不要往前走。"],
		["拾潮者", "下面出了什么事？为什么要撤人？"],
		["负壳守卫", "支撑住巢的一根梁歪了，住户还没撤完。我们得先把他们接上来，这段路现在不能走。"],
		["拾潮者", "我从外海追着一阵低鸣来到这里，声音好像就在井底。我想下去找一找。"],
		["负壳守卫", "我们在下面拖壳、敲梁，什么声音都有。你等住户都撤上来，再下去找。"],
		["拾潮者", "住户大概要多久才能撤完？"],
		["负壳守卫", "最里面还有人没出来，我现在说不准。等最后一户上来，我会叫你。"],
		["拾潮者", "我担心那阵低鸣再停下来，就找不到声音的来处了。我能沿路边绕过去吗？我不会靠近那根歪梁。"],
		["负壳守卫", "路边也要留给撤离的人走。你现在过去会挡住他们，先回上面的平台等。"]
	],
	"aftermath": [
		["旁白", "负壳守卫伏在脱落的旧壳旁。他还活着，钳尖仍朝着下层住巢的方向。"],
		["负壳守卫", "下面还有住户没撤上来！你别再往下走了！"]
	],
	"permit": [
		["老守护者", "折井下面还有住户没上来吗？"],
		["住户", "住户都在这儿了，最里面那一家也出来了。"],
		["老守护者", "你们先去胃室安顿，别挤在这处断口上。"],
		["老守护者", "你的旧壳怎么拖在地上？扣带怎么断了？"],
		["负壳守卫（上层）", "他非要往下走。我拦住他，我们打了起来，扣带也打断了。"],
		["拾潮者", "是我不肯退回去，越过了警戒线。后来我们打了起来，守卫也受了伤。"],
		["老守护者", "守卫跟你说过，下面还有住户没有撤完吗？"],
		["拾潮者", "他说过下面还有住户，我还是想从旁边绕过去。"],
		["旁白", "老守护者没有接话，转身看了看等在断口旁的住户。"],
		["拾潮者", "我当时只顾着找井底的声音，怕声音停了就再也找不到了。"],
		["老守护者", "这几户住户还要去胃室。你先让开通道，让他们过去。"],
		["负壳守卫", "住户都撤上来了，这段路还要封着吗？"],
		["老守护者", "不用再拦着了。你先歇着，等修梁的人下来。"],
		["拾潮者", "我能沿右边的路去胃室吗？"],
		["老守护者", "可以。这几户住户也要去胃室，你跟着他们走。"]
	],
	"complete": [
		["住户", "我们沿前面这条路去胃室，你跟我们一起走吧。"],
