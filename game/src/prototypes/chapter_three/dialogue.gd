class_name ChapterThreeDialogue
extends RefCounted
## 居民只请来客赶开大甲，不为未知水路背书；主角依据局部现象误判。
const LINES: Dictionary = {
	"arrival":[["住户","就是这里。东西先搁高处，别放水边。"]],
	"meet":[
		["补巢者","小心脚下。底下那根绳还没系上。"],
		["拾潮者","你也搬到这里来了？"],
		["补巢者","这是我亲族的巢。刚从折井过来的，先挤一挤。"],
		["拾潮者","巢后面这些，也是你们种的？"],
		["补巢者","嗯。换了两回菌种，还是这样。你看，刚长出来就卷了。"],
		["拾潮者","水里全是絮，排不出去？"],
		["补巢者","从底下又绕回来了。那槽里还窝着只大甲，靠近就扑人。"],
		["拾潮者","我去把它引开。你们先别下槽。"]],
	"basin":[
		["旁白","一簇污絮漂过槽口，绕了一圈，又贴回菌床边。"],
		["拾潮者","这边流不出去。我去里面看看。"]],
	"valve":[
		["旁白","旧瓣边缘裂开一条缝。积水带着污絮往外漏，附近露出一小块槽底。"],
		["拾潮者","水能从这里出去。把缝再挑开一点……"]],
	"after":[
		["补巢者","压住这边！别让巢片再滑了！"],
		["拾潮者","我抓住了。"],
		["老守护者","先上高台，东西别拿了！"],
		["旁白","旧瓣被重新压住。菌床上只剩几缕断丝，住户挤在高台内侧。"],
		["老守护者","谁动的旧瓣？"],
		["拾潮者","我。刚才水往外流，我以为……"],
		["老守护者","你往另一头看过没有？"],
		["拾潮者","没有。"],
		["补巢者","下面那片壳还能用。替我捡回来。"]],
	"fixed":[
		["补巢者","再往上托一点。对，就那里。"],
		["拾潮者","系住了。……对不起。"],
		["补巢者","这边也勒紧，夜里还会涨水。"],
		["拾潮者","菌床还能重新种吗？"],
		["补巢者","我也不知道。先把巢补好吧，他们今晚还没地方住。"],
		["拾潮者","这里的水，是从哪边过来的？"],
		["补巢者","右边上去是脂库。你要去就问看守，别自己动那里的东西。"]],
	"complete":[["白盒验证结束","已到肝缘脂库入口。F继续第四章白盒。R回检查点，F6重开本章。"]]
}
static func lines(id: String) -> Array[Array]:
	var result: Array[Array] = []
	for line: Array in LINES.get(id,[]): result.append(line.duplicate())
	return result
