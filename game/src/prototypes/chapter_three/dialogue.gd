class_name ChapterThreeDialogue
extends RefCounted
## 菌床受损、水槽调查和大甲阻路构成行动因果；回水查看保持可选。
const LINES: Dictionary = {
	"arrival": [
		["住户", "这里就是胃室。补巢者的亲族住在前面的菌床旁边，我们先去他们那里安顿。"]
	],
	"meet": [
		["补巢者", "你们从折井上来了？先到住巢前的平台歇一歇。"],
		["拾潮者", "折井的住户都撤出来了，我跟他们过来的。你身后那片发灰的东西，是你们种的菌床吗？"],
		["补巢者", "是菌床，我们靠它长出的菌丝吃饭。最近新长的菌丝一碰回水就卷起来，换了两回菌种也没有用。"],
		["拾潮者", "水槽里的水看起来很脏。你们试过把菌床旁边的脏水排走吗？"],
		["补巢者", "我们沿水槽去看过，脏水一直从里面流回来。排水口附近有一只栖污大甲，它占住了槽口，谁靠近它就扑谁，我们没法过去查看排水口。"],
		["拾潮者", "我去把栖污大甲赶离槽口，再看看脏水为什么会流回来。你们带着折井的住户留在高台上，不要靠近水槽。"]
	],
	"basin": [
		["旁白", "水槽里的碎屑漂过菌床旁边，绕了一圈，又随回水贴回菌床边缘。"],
		["拾潮者", "这些碎屑排不出去，一直在菌床旁边打转。我去水槽里面看看，排水口是不是堵住了。"]
	],
	"valve": [
		["旁白", "一扇旧瓣挡在排水口，像一道封住水路的门。旧瓣边缘已经裂开，脏水正从裂缝漏出去，近处水槽里的碎屑少了。"],
		["拾潮者", "这里只漏出去一点水。我把旧瓣撬开一些，看看菌床旁边的积水能不能退下去。"]
	],
	"after": [
		["旁白", "老守护者带着守卫赶到胃室，重新压住旧瓣，救出了住户。拾潮者回到高台时，补巢者还在扶着滑落的巢片。"],
		["补巢者", "你回来了。住户都已经上了高台，巢片却从原来的位置滑下来了。请帮我托住巢片，别让巢片掉进水槽。"],
		["拾潮者", "我来托住巢片。刚才那股水是从哪里冲过来的？"],
		["老守护者", "水从旧瓣另一头的水道绕回来了。守卫已经把旧瓣重新压住，住户暂时安全。刚才是谁撬开了旧瓣？"],
		["拾潮者", "是我。我看到裂缝在排水，以为把旧瓣撬大一点，就能排走菌床旁边的脏水。"],
		["老守护者", "你查看过旧瓣另一头的水道吗？那边的水还会从旁边的槽口转回来。"],
		["拾潮者", "我只看了眼前的排水口，没有去看水流到了哪里。"],
		["旁白", "旧瓣已经合拢，回水渐渐缓下来。菌床上只剩下几缕断丝，住户挤在高台内侧。"],
		["补巢者", "巢片先交给我扶着。左边浅滩上有一片掉下来的旧壳，还能补住巢的缺口。请你把旧壳捡回来。"]
	],
	"fixed": [
		["补巢者", "请把旧壳托到住巢的缺口上，再往上抬一点，我把系绳绕过去。"],
