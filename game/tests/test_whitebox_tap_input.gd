extends TestSuite
## 从真实键盘事件进入InputMap，验证组合优先、连招、蓄力和清理。

func key(code: int, down: bool) -> void:
	var event := InputEventKey.new()
	event.keycode = code
	event.pressed = down
	Input.parse_input_event(event)

func fixture() -> Node2D:
	var arena: Node2D = preload("res://tests/whitebox_combat/main.tscn").instantiate()
	add(arena)
	await physics_frames(8)
	return arena

func after_each() -> void:
	for code: int in [KEY_Q,KEY_E,KEY_J,KEY_K,KEY_I,KEY_L,KEY_W,KEY_A,KEY_S,KEY_D,KEY_ESCAPE,KEY_SPACE,KEY_SHIFT]: key(code,false)
	await physics_frames(1)
	await super.after_each()

func select_tap(code: int) -> void:
	key(code,true)
	await physics_frames(2)
	key(code,false)
	await physics_frames(2)

func test_released_q_allows_left_turn_and_three_k_continuations() -> void:
	var arena := await fixture()
	await select_tap(KEY_Q)
	check(not Input.is_action_pressed("wb_lt"),"Q is already released before moving and selecting")
	key(KEY_A,true)
	for step: int in 3:
		if step == 1:
			key(KEY_A,false)
			key(KEY_D,true)
		key(KEY_K,true)
		await physics_frames(3)
		eq(arena.player.skill_controller.drive_step,step+1,"K continues triple without holding Q")
		eq(arena.player.skill_controller.locked_facing,-1.0 if step==0 else 1.0,"direction is sampled freely from A/D")
		key(KEY_K,false)
		await physics_frames(19)

func test_released_e_allows_right_movement_and_spell_selection() -> void:
	var arena := await fixture()
	await select_tap(KEY_E)
	key(KEY_D,true)
	await physics_frames(6)
	check(arena.player.position.x > 550,"can move right after releasing E")
	key(KEY_L,true)
	await physics_frames(3)
	eq(arena.player.state,"A4_parry","L selects orb after tapping E instead of dash")
	check(not arena.player.pad_input.modified(),"skill consumes the one-shot page")

func test_consumed_page_leaves_guard_available_and_expired_page_restores_jump() -> void:
	var arena := await fixture()
	await select_tap(KEY_Q)
	key(KEY_K,true)
	await physics_frames(12)
	key(KEY_K,false)
	key(KEY_I,true)
	await physics_frames(3)
	eq(arena.player.skill_controller.visual_key,"parry","I guards during triple chain rather than selecting sweep")
	key(KEY_I,false)
	arena.reset_arena()
	await physics_frames(3)
	await select_tap(KEY_Q)
	await physics_frames(55)
	key(KEY_SPACE,true)
	await physics_frames(4)
	check(arena.player.position.y < 540,"Space jumps after expired selection")

func test_tapped_pages_allow_right_hand_only_heal_and_long_charge() -> void:
	var arena := await fixture()
	arena.player.health = 3
	await select_tap(KEY_E)
	key(KEY_I,true)
	await physics_frames(60)
	eq(arena.player.state,"recover","healing continues with only right-hand I held beyond selection timeout")
	key(KEY_I,false)
	await physics_frames(3)
	check(arena.player.state != "recover","releasing I alone stops heal")
	arena.reset_arena()
	await physics_frames(3)
	await select_tap(KEY_Q)
	await select_tap(KEY_E)
	eq(arena.player.pad_input.selected_page,3,"Q then E selects utility without holding either")
	key(KEY_L,true)
	await physics_frames(44)
	key(KEY_L,false)
	await physics_frames(3)
	eq(arena.player.skill_controller.visual_key,"crystal_dash","right-hand L alone charges then releases long dash")

func test_direction_attack_skills_preserve_movement_air_pogo_and_dash_slash() -> void:
	var arena := await fixture()
	key(KEY_A,true)
	key(KEY_W,true)
	key(KEY_J,true)
	await physics_frames(3)
	eq(arena.player.skill_controller.visual_key,"wb_rise","W+J directly selects launcher")
	check(arena.player.skill_controller.locked_facing < 0,"A can aim direct launcher left")
	key(KEY_J,false)
	key(KEY_A,false)
	key(KEY_W,false)
	arena.reset_arena()
	await physics_frames(3)
	key(KEY_S,true)
	key(KEY_J,true)
	await physics_frames(3)
	eq(arena.player.skill_controller.visual_key,"wb_draw","ground S+J directly selects sweep")
	key(KEY_J,false)
	key(KEY_S,false)
	arena.reset_arena()
	await physics_frames(3)
	key(KEY_D,true)
	key(KEY_SPACE,true)
	await physics_frames(9)
	check(arena.player.position.y < 540 and arena.player.position.x > 550,"A/D+Space performs running jump")
	key(KEY_SPACE,false)
	key(KEY_S,true)
	key(KEY_J,true)
	await physics_frames(3)
	eq(arena.player.state,"A3_anchor","air S+J still performs pogo rather than sweep")
	key(KEY_J,false)
	key(KEY_S,false)
	key(KEY_D,false)
	arena.reset_arena()
	await physics_frames(3)
	key(KEY_L,true)
	await physics_frames(3)
	key(KEY_W,true)
	key(KEY_J,true)
	await physics_frames(3)
	eq(arena.player.skill_controller.visual_key,"dash_slash","dash follow-up wins over standing uppercut")

func test_mobile_skills_use_a_d_with_face_for_turning() -> void:
	var arena := await fixture()
	key(KEY_A,true)
	key(KEY_K,true)
	await physics_frames(3)
	eq(arena.player.skill_controller.visual_key,"wb_drive","A+K starts triple without W or shoulders")
	check(arena.player.skill_controller.locked_facing < 0,"A freely directs first step left")
	key(KEY_K,false)
	key(KEY_A,false)
	key(KEY_D,true)
	await physics_frames(15)
	key(KEY_K,true)
	await physics_frames(3)
	eq(arena.player.skill_controller.drive_step,2,"K alone continues second step while holding direction only")
	check(arena.player.skill_controller.locked_facing > 0,"D freely directs next step right")
	key(KEY_K,false)
	key(KEY_D,false)
	arena.reset_arena()
	await physics_frames(3)
	key(KEY_A,true)
	key(KEY_L,true)
	await physics_frames(3)
	eq(arena.player.skill_controller.visual_key,"wb_charge","A+L starts moving launch without W or shoulders")
	check(arena.player.skill_controller.locked_facing < 0,"moving launch locks requested left direction")

func test_k_never_jumps_and_space_works_while_skill_page_is_selected() -> void:
	var arena := await fixture()
	key(KEY_K,true)
	await physics_frames(4)
	eq(arena.player.skill_controller.visual_key,"wb_drive","K alone starts facing-direction triple")
	check(arena.player.is_on_floor(),"K cannot accidentally jump")
	key(KEY_K,false)
	arena.reset_arena()
	await physics_frames(3)
	await select_tap(KEY_Q)
	key(KEY_D,true)
	key(KEY_SPACE,true)
	await physics_frames(8)
	check(arena.player.position.y < 540 and arena.player.position.x > 550,"Space still performs running jump with a page selected")
	check(not arena.player.skill_controller.active,"Space does not select triple from Q page")
	key(KEY_SPACE,false)
	await physics_frames(2)
	key(KEY_SPACE,true)
	await physics_frames(3)
	eq(arena.player.jump_count,2,"Space also owns second jump")

func test_moving_l_launch_standing_l_dash_and_down_l_backstep() -> void:
	var arena := await fixture()
	key(KEY_D,true)
	key(KEY_L,true)
	await physics_frames(3)
	eq(arena.player.skill_controller.visual_key,"wb_charge","moving L chooses launch")
	check(arena.player.skill_controller.locked_facing > 0,"launch aims right")
	key(KEY_L,false)
	key(KEY_D,false)
	arena.reset_arena()
	await physics_frames(3)
	key(KEY_L,true)
	await physics_frames(3)
	eq(arena.player.state,"A1_dash","L without movement remains basic dash")
	key(KEY_L,false)
	arena.reset_arena()
	await physics_frames(3)
	key(KEY_D,true)
	key(KEY_S,true)
	key(KEY_L,true)
	await physics_frames(3)
	check(arena.player.retreating,"S+L takes priority even while moving")
	check(arena.player.invulnerable <= 0,"backstep does not gain launch or dash defense")

func test_shift_remains_basic_moving_dash_backup() -> void:
	var arena := await fixture()
	key(KEY_A,true)
	key(KEY_SHIFT,true)
	await physics_frames(3)
	eq(arena.player.state,"A1_dash","moving Shift remains a basic dash instead of launch")
	check(arena.player.skill_controller.visual_key != "wb_charge","only L face key selects moving launch")
