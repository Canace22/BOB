extends "res://tests/enemy_lab_qa.gd"
## 实际F1/J/I/空格输入验证；单招使用明确的两端站位夹具。
func setup_eel(tail: bool=false) -> EnemyLabEel:
	lab.reset_round()
	await tick(14)
	var e: EnemyLabEel=lab.enemies[0] as EnemyLabEel
	e.position=Vector2(800,520)
	lab.player.position=Vector2(980 if tail else 620,520)
	lab.player.facing=-1.0 if tail else 1.0
	return e

func run() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT))
	lab=load("res://content/prototypes/enemy_lab/main.tscn").instantiate()
	lab.auto_attack=false
	lab.ranges=false
	root.add_child(lab)
	current_scene=lab
	await tick(14)
	for i: int in 4: await tap(KEY_F1)
	await tick(10)
	check("real F1 selects fifth enemy and flat arena",lab.enemies[0] is EnemyLabEel and lab.terrain==0)
	check("four-move menu exposes special nest actions",lab.hud.move_menu.item_count==5)
	await shot("eel-overview")
	var e: EnemyLabEel=await setup_eel()
	e.begin_attack("eel_bite")
	await tick(30)
	check("jaw preparation uses separate S-coil pose",e.visual.pose_id in [4,5] and e.facing==-1.0)
	check("ordinary eel action has no red warning",float((e.visual.material as ShaderMaterial).get_shader_parameter("danger"))==0.0)
	await shot("eel-jaw-windup")
	await tick(28)
	check("jaw reaches nearby head-side player",lab.player.health==4 and e.hit_count==1)
	await shot("eel-jaw-contact")
	e=await setup_eel(true)
	e.begin_attack("eel_bite")
	await tick(65)
	check("head bite never damages player at tail",lab.player.health==5)
	e=await setup_eel(true)
	key(KEY_I,true)
	await tick(11)
	var original_x: float=e.position.x
	e.begin_attack("eel_tail")
	await tick(62)
	key(KEY_I,false)
	check("real front I blocks tail at its own endpoint",lab.player.health==5 and e.parry_count==1)
	check("tail block does not pull head toward player",absf(e.position.x-original_x)<1.0)
	await shot("eel-tail-block")
	e=await setup_eel(true)
	e.begin_attack("eel_tail")
	await tick(27)
	check("tail has its own coiled anticipation",e.visual.pose_id in [8,9])
	await shot("eel-tail-windup")
	key(KEY_SPACE,true)
	await tick(30)
	key(KEY_SPACE,false)
	await tick(10)
	check("real jump clears committed low tail sweep",lab.player.health==5 and e.hit_count==0)
	await shot("eel-tail-jump")
	e=await setup_eel()
	key(KEY_I,true)
	await tick(11)
	e.begin_attack("eel_bite")
	await tick(57)
	key(KEY_I,false)
	check("real I blocks jaw and opens retaliation",lab.player.health==5 and e.parry_count==1 and e.state=="recover")
	var health: int=e.health
	key(KEY_J,true)
	await tick(14)
	key(KEY_J,false)
	check("real J converts jaw guard into damage",e.health<health)
	await shot("eel-jaw-counter")
	await tick(100)
	check("counter budget ends and eel stays grounded",e.state=="idle" and e.is_on_floor())
	key(KEY_R,true)
	await tick(2)
	key(KEY_R,false)
	await tick(14)
	check("actual R replaces old body and both attacks",not is_instance_valid(e) and lab.enemies[0].health==18)
	e=await setup_eel(true)
	e.auto_attack=true
	e.attack_serial=2
	await tick(48)
	check("natural tail dwell selects full visible preparation",e.move_key=="eel_tail" and e.state=="tell")
	e=await setup_eel()
	lab.player.position=Vector2(420,520)
	e.auto_attack=true
	key(KEY_D,true)
	await tick(30)
	key(KEY_D,false)
	await tick(45)
	check("actual approach triggers natural nest attack",e.attack_serial>0 and e.move_key in ["eel_brood","eel_burrow"])
	print("ENEMY_LAB_EEL failures=",failures)
	lab.queue_free()
	lab=null
	await tick(6)
	quit(1 if failures else 0)
