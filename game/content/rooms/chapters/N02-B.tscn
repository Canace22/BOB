position = Vector2(535, 800)
title = "负壳守卫"
pages = Array[String](["“下层封闭。来客，返回须庭。”\n重壳压在通路中央，两条扣带绷得笔直。", "壳缘会挡住正面攻击。\n看它抬钳或压壳，避开出招；绕到扣带一侧，或等收招后反击。"])
flag_id = "chapter.challenge"
