[node name="Rescue" type="Node2D" parent="Gameplay"]
script = ExtResource("r14")
position = Vector2(2020, 800)
title = "守住路的人"
pages = Array[String](["老守护者把住巢托回稳台，才回头接受来客的问候。\n“要找歌声，就沿胃室的供养路走。但先看清楚，路上住着谁。”", "负壳守卫仍活着。它低下钳子，重新收拢松开的扣带。\n第一、二章试玩结束。可以返回寻找两处回声，或按 Esc 重新开始。"])
flag_id = "chapter.complete"
prerequisites = Array[String](["chapter.guard"])
automatic = false
prompt = "E 听取共鸣"

