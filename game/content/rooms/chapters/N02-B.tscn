[node name="Rescue" type="Node2D" parent="Gameplay"]
position = Vector2(2050, 896)
script = ExtResource("story")
title = "第二章 · 守住路的人"
pages = Array[String](["扣带断开，负壳守卫放下钳子。下层忽然传来求救：承路旧膜裂了，住巢正向深处滑落。", "老守护者越过众人，将长柄横进支架，顶住弯曲的梁。直到居民全部爬上稳台，他才回头看向你。\n“要找歌声，就沿胃室的供养路走。但先看清楚，路上住着谁。”", "两章试玩完成。\n负壳守卫仍活着，老守护者允许你继续前行。下一章尚未开放，可以返回探索两处回声，或按 Esc 重新开始。"])
flag_id = "chapter.complete"
prompt = "E 查看住巢的呼救"
automatic = false
prerequisites = Array[String](["chapter.guard"])

