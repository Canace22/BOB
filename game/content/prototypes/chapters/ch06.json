            1790,
            480
          ],
          "requires": [],
          "grant": [
            "ch06_patrol_record_gap"
          ],
          "lines": [
            [
              "拾潮者",
              "封片上有新补的刻号，巡视外流的最后一条却磨得快看不清了。"
            ],
            [
              "肺缘看守",
              "每次都来补片，没再添外流记录。我可以同你重新记一轮，但旧片还不能拆。"
