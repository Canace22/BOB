          ],
          "lines": [
            [
              "肺缘看守",
              "这边的承托完整。先清掉碎壳，窄线画在背流侧。真要引水，还得有人守着封口。"
            ],
            [
              "拾潮者",
              "我把线画到这里，不碰红绳以内。去泵庭时，我会把你的要求一起带过去。"
            ]
          ]
        }
      ],
      "required": [
        "ch06_compare_samples",
        "ch06_protect_membrane_a",
        "ch06_protect_membrane_b",
        "ch06_clear_slow_inlet"
