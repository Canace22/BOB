  "stages": [
    {
      "id": "ch06_01_patrol",
      "kind": "dialogue",
      "objective": "向右到低灯巡视点，与看守交谈",
      "checkpoint": [
        160,
        480
      ],
      "at": [
        430,
        480
      ],
      "lines": [
        [
          "肺缘看守",
          "请把菌灯罩低。上层暴露台有捕食者，它会循着亮光扑过来；下面残壁后面的观察位有遮挡，可以避开它。"
        ],
        [
          "拾潮者",
          "我从肠环来，迁居的居民还缺食物。脂库只留了一道小水缝，槽边就有新菌丝附着；我带着壳样和记录，想看看肺缘的外海水能不能进来。"
        ],
        [
          "肺缘看守",
          "肺缘的封片挡着外海水，后面有些支膜已经变脆了。脂库能留缝，不代表这里也能开。我只熟悉检查封片，外海现在的水况，我没有近年的记录。"
        ],
        [
          "拾潮者",
          "那就先不拆封片。我想看一看不同潮位的水流，再把同样大小的壳片放到几处水路里，看看各处能留下什么。"
        ],
        [
          "肺缘看守",
          "你先从下方残壁后的窄窗看。右边已有三处采样位置：强流口、支撑背面的避流口，还有不通外海的内水槽，采样的壳片放在那些位置旁。我们可以一起比较。"
        ]
      ]
    },
    {
      "id": "ch06_02_outside",
      "kind": "explore",
      "objective": "在底层遮蔽位按F看外海；也可选择登上暴露台遭遇捕食者。随后向右核对旧刻痕",
      "checkpoint": [
        530,
        480
      ],
      "at": [
        730,
        480
      ],
      "enemy": {
        "profile": 3,
        "at": [
          1400,
          270
        ],
        "lane": [
          1180,
          1550
        ],
        "ending": "retreat",
        "optional": true
      },
      "tasks": [
        {
          "id": "ch06_sheltered_view",
          "label": "遮蔽位：按F透过残壁窄缝观察外海，无需击败捕食者",
          "at": [
            730,
            480
          ],
          "requires": [],
          "grant": [
            "ch06_outside_seen"
          ],
          "lines": [
            [
              "拾潮者",
              "窄窗外的沉积坡上长着许多附着生物。远处水流很急，支撑背面却有一条比较缓的水带。"
            ],
            [
              "肺缘看守",
              "支撑把那条水带和外侧的急流隔开了。你站在残壁后就能看清水带，不用走上有捕食者的暴露台。"
            ]
          ]
        },
        {
          "id": "ch06_exposed_view",
          "label": "可选暴露台：沿三级台阶上行，按F观察外海；可撤回底层",
          "at": [
            1510,
            270
          ],
          "requires": [],
          "grant": [
            "ch06_outside_seen"
          ],
          "lines": [
            [
              "拾潮者",
              "暴露台外的水流很急，支撑背面有一条较缓的水带。这里没有残壁遮挡，我还是回下方观察位查看水带，避开捕食者。"
            ]
          ]
        },
        {
          "id": "ch06_compare_marks",
          "label": "旧刻痕：按F把当年浊流方向、封片厚度与脂库拓片并排核对",
          "at": [
            1790,
            480
          ],
          "requires": [],
          "grant": [
            "ch06_patrol_record_gap"
          ],
          "lines": [
            [
              "拾潮者",
              "封片上有新补的刻号，窄窗旁记录外海流向的刻痕却磨得快看不清了。你们一直只检查封片吗？"
            ],
            [
              "肺缘看守",
              "我平时只检查封片是否完整，外海流向的旧记录一直没有补。这次我和你一起重新记。"
            ],
            [
              "拾潮者",
              "我把窄窗和三处采样位置画在一张引水位置图上。我们查到的水况和不能开的地方，也都记在图上，免得来商量引水的人认错水口。"
            ]
          ]
        }
      ],
      "required": [
        "ch06_compare_marks"
      ],
      "any": [
        "ch06_sheltered_view",
        "ch06_exposed_view"
      ]
    },
