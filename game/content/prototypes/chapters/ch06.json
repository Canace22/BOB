  "stages": [
    {
      "id": "ch06_01_patrol",
      "kind": "dialogue",
      "objective": "向右到低灯巡视点，与看守交谈",
      "checkpoint": [
        160,
        480
      ],
      "at": [
        430,
        480
      ],
      "lines": [
        [
          "肺缘看守",
          "把灯罩低。上面那东西会往亮处扑。"
        ],
        [
          "拾潮者",
          "我从肠环来。迁居的人想知道，新水能不能进来。脂库只开了一条小缝，记录在这里。"
        ],
        [
          "肺缘看守",
          "我的父辈教我查封片有没有裂。外面水怎样，他们没留下近年的记载。"
        ],
        [
          "拾潮者",
          "我想从巡视窗看几次潮，也放几片壳样。"
        ],
        [
          "肺缘看守",
          "下面这块残壁后有窄缝，够你看，不必上暴露台。放样的水路在右边，我带你过去。"
        ]
      ]
    },
    {
      "id": "ch06_02_outside",
      "kind": "explore",
      "objective": "在底层遮蔽位按F看外海；也可选择登上暴露台遭遇捕食者。随后向右核对旧刻痕",
