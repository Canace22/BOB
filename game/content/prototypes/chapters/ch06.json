      "lines": [
        [
          "鲸的残留回声",
          "亮水从身体下方托过。远处，一声回应穿过漫长的水。"
        ],
        [
          "拾潮者",
          "刚才有一瞬，我看不见这面墙了。"
        ],
        [
          "肺缘看守",
          "我只听见膜在响。你还能走吗？"
        ],
        [
          "拾潮者",
          "能。样片和图都在，两个红绳位也没有动。"
        ],
        [
          "肺缘看守",
          "泵庭从下方裂隙过去。告诉他们，这一轮是我同你记的。我会留在这里，再看下一潮。"
        ],
        [
          "拾潮者",
          "我会写上你的巡视点。要是水位变了，把新线留在这块板上。"
        ]
      ]
    },
