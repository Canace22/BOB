            480
          ],
          "requires": [
            "ch06_compare_samples"
          ],
          "grant": [
            "ch06_membrane_a_protected"
          ],
          "lines": [
            [
              "肺缘看守",
              "这片膜一鼓，边缘就发白。这里不能开，我会继续补护。"
            ],
            [
              "拾潮者",
              "我系红绳，把裂边和潮位一并画上。"
            ]
          ]
        },
        {
          "id": "ch06_protect_membrane_b",
          "label": "脆膜乙：按F系红绳，标记断撑下方同样不得开口",
          "at": [
            3260,
            480
          ],
          "requires": [
            "ch06_compare_samples"
          ],
          "grant": [
