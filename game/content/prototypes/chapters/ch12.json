  "stages": [
    {
      "id": "ch12_return_name",
      "kind": "dialogue",
      "objective": "到记录台按F，交还刻名薄壳并说出死亡和证据。",
      "checkpoint": [
        160,
        480
      ],
      "at": [
        600,
        480
      ],
      "lines": [
        [
          "记录",
          "老守护者暂时把长柄抵在闸撑上。拾潮者解下薄壳，交到他手里。"
        ],
        [
          "拾潮者",
          "负壳守卫托我把这片壳交给你。封梁卫死在骨梁上。我们交战时，我贴近壳缝回刺，他倒下以后就没有再回应。"
        ],
        [
          "记录",
          "老守护者的手指停在姓名上，沿着刻痕慢慢摸过。"
        ],
        [
          "老守护者",
          "他一直守在那段梁上？"
        ],
        [
          "拾潮者",
          "他收了通行索，要迁来的住巢退回去。我越过收索的位置，我们就在梁上动了手。"
        ],
        [
          "记录",
          "老守护者没有再问，把薄壳收进身侧。拾潮者等他重新抬起头，才展开记录。"
        ],
        [
          "拾潮者",
          "胃室那片菌床也是我开瓣时冲坏的。损失的位置记在这里。回流长腔有巢安稳下来，也有新巢被急流冲松，我们已经挡回了那处小口。"
        ],
        [
          "拾潮者",
          "新丝长出来了，旧壳还在变薄。肺缘来水稳定，尾根的外排线却折回内圈。听骨的停顿和回压对得上，供养记录也没有好转。"
        ],
        [
          "老守护者",
          "我看见了。你把图放下。先告诉我，第一次外排要是损坏主闸，骨台上的居民能往哪里退。"
        ]
      ]
    },
    {
      "id": "ch12_dispute_patch",
      "kind": "dialogue",
      "objective": "到退流槽旁按F，说明有限方案并面对封闸决定。",
      "checkpoint": [
        820,
        480
      ],
      "at": [
        1130,
        480
      ],
      "lines": [
        [
          "拾潮者",
          "两侧旧撑和退流槽都保留。这几处住巢还没有安顿，不动它们的支路。我只开窄缝，观察一轮潮；水太强或闸撑偏移，就先停下来。"
        ],
        [
          "老守护者",
          "主闸比你开过的口子大得多。缝一旦被扯开，你未必关得回去。我会继续加固，把进水退回原来的限度。"
        ],
        [
          "负壳守卫",
          "补片到了。内侧那条槽又开始涨水，刚迁过去的巢还在上面。"
        ],
        [
          "拾潮者",
          "请先不要把补片压进去。回水正在往他们那里走。"
        ],
        [
          "记录",
          "拾潮者伸手拦住运往闸前的补片。老守护者抽出长柄，挡住他的去路。负壳守卫让搬运者和居民退到内侧稳台。"
        ],
        [
          "老守护者",
          "退开。我不能让你现在碰这道闸。"
        ]
      ]
