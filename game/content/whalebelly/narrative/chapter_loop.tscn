[node name="Aftermath" type="Node2D" parent="."]
script = ExtResource("trigger")
dialogue_id = "loop.aftermath"
room_id = "R1-01"
area = Rect2(1280, -1000, 800, 3000)
required_seen = PackedStringArray("loop.passage")
speakers = PackedStringArray("补巢者", "拾潮者", "补巢者", "拾潮者")
lines = PackedStringArray("站到菌灯旁边来。食腐甲只护着菌膜，离那片菌膜远一点，它们就不会再扑你。", "那阵低鸣又响了，像是从脚下传来的。这里有通往下层的路吗？", "前面的骨拱通往折井，沿折井可以去更深的地方。不过守卫把路封住了，你要先问他们，别自己闯下去。", "谢谢你。我去找折井的守卫问路。")
objective_id = "loop.go_foldwell"
objective_text = "向右进入前方骨拱 · 通道向下通往折井"
