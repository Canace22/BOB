[node name="Warning" type="Node2D" parent="."]
script = ExtResource("trigger")
dialogue_id = "loop.warning"
room_id = "R1-01"
area = Rect2(360, 370, 270, 330)
required_seen = PackedStringArray("loop.arrival")
speakers = PackedStringArray("补巢者", "拾潮者", "补巢者")
lines = PackedStringArray("你先停一下。前面两只食腐甲正在吃菌膜，你再往前走，它们会以为你来抢食，从两边一起扑过来。", "我从外海追着一阵低鸣来到这里，声音像是从你身后的通道传来的。我想过去找一找。", "食腐甲只护着那片菌膜，不会一直追人。你可以先上前面较高的骨台看看，等食腐甲扑空，再从它旁边过去。")
objective_id = "loop.cross_feeding"
objective_text = "穿过聚食区 · 抓扑空的机会压退或绕过甲壳"

