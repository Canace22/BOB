speakers = PackedStringArray("补巢者", "拾潮者", "补巢者")
lines = PackedStringArray("你从外面来？前面两只甲壳守着菌膜。靠近它们就会扑过来，别让它们从两边夹住。", "低鸣是从那边传来的。我想进去看看。", "上面的骨台能看清它们。也可以从下路靠近，等它扑空，再过去。越过聚食区，我会从安全处叫住你。")
objective_id = "loop.cross_feeding"
objective_text = "穿过聚食区 · 抓扑空的机会压退或绕过甲壳"

