{
  "schemaVersion": 1,
  "phase": "all-static-before-animation",
  "pixelsPerUnit": 128,
  "coordinateContract": "atBasePixel 是原始基底画布局部坐标，先乘base world尺度，再把子件anchorPixel对到此点；子件用自己的world尺度。缺anchorPixel时使用manifest pivot。rotationDeg绕anchor旋转，z从小到大绘制。 所有world尺寸以catalog的bbox轴长计算。baseBrightness为程序绘制亮度，inheritBaseRotation=false允许邻近NPC不随壳托转动。",
  "formulas": {
    "assetScale": "world.units * pixelsPerUnit / bbox-axis-length",
    "childPosition": "baseOrigin + (atBasePixel - basePivot) * baseScale",
    "childDraw": "translate(childPosition); rotate(rotationDeg); scale(childScale); drawImage(-anchorPixel.x,-anchorPixel.y)"
  },
